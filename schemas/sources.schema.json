{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/StockmarketAgent/schemas/sources.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_version", "reviewed_at", "live_adapters_enabled", "publication_boundary", "sources", "policies"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_version": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "live_adapters_enabled": {"const": false},
    "publication_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_data_commit", "github_pages", "secrets"],
      "properties": {
        "raw_data_commit": {"type": "string", "minLength": 1},
        "github_pages": {"type": "string", "minLength": 1},
        "secrets": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "publisher", "countries", "data_classes", "documentation_url", "access_method", "authentication", "key_required", "rate_limit", "history_depth", "point_in_time_status", "license_status", "license_url", "retention", "redistribution", "pages_policy", "feasibility", "fallback", "gaps"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "publisher": {"type": "string", "minLength": 1},
          "countries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["TW", "JP", "US"]}},
          "data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["listing_metadata", "eod_prices", "corporate_actions", "filings_financials", "etf_fund_data", "market_calendar", "fx", "benchmark"]}},
          "documentation_url": {"type": "string", "pattern": "^https://"},
          "access_method": {"type": "string", "minLength": 1},
          "authentication": {"enum": ["none", "api_key", "contract_credentials", "manual_download"]},
          "key_required": {"type": "boolean"},
          "rate_limit": {"type": "string", "minLength": 1},
          "history_depth": {"type": "string", "minLength": 1},
          "point_in_time_status": {"enum": ["supported", "partial", "unknown", "not_supported"]},
          "license_status": {"enum": ["open_with_attribution", "free_reuse", "metadata_only", "contract_required", "not_usable"]},
          "license_url": {"type": "string", "pattern": "^https://"},
          "retention": {"type": "string", "minLength": 1},
          "redistribution": {"type": "string", "minLength": 1},
          "pages_policy": {"enum": ["raw_with_attribution_allowed", "derived_only", "metadata_only", "not_allowed"]},
          "feasibility": {"enum": ["ready", "conditional", "blocked", "reference_only"]},
          "fallback": {"type": "string", "minLength": 1},
          "gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "policies": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_policy_id", "country", "asset_type", "coverage"],
        "properties": {
          "source_policy_id": {"type": "string", "minLength": 1},
          "country": {"enum": ["TW", "JP", "US"]},
          "asset_type": {"enum": ["stock", "etf"]},
          "coverage": {
            "type": "array", "minItems": 8, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["data_class", "status", "primary_source_ids", "fallback_source_ids", "note"],
              "properties": {
                "data_class": {"enum": ["listing_metadata", "eod_prices", "corporate_actions", "filings_financials", "etf_fund_data", "market_calendar", "fx", "benchmark"]},
                "status": {"enum": ["ready", "conditional", "blocked", "reference_only", "not_applicable"]},
                "primary_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "fallback_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "note": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
