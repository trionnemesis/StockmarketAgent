{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/StockmarketAgent/schemas/universe-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_version", "universe_version", "evidence_as_of", "review_status", "instruments", "overlap_groups", "issuer_concentration", "owner_decisions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_version": {"type": "string", "minLength": 1},
    "universe_version": {"type": "string", "minLength": 1},
    "evidence_as_of": {"type": "string", "format": "date"},
    "review_status": {"const": "owner_decision_required"},
    "instruments": {
      "type": "array", "minItems": 30, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["instrument_id", "listing_status", "verification_status", "symbol", "exchange", "legal_name", "asset_type", "trading_currency", "benchmark_id", "selection_rationale", "official_url", "history", "liquidity", "theme_evidence", "replacement_assessment", "review_flags", "models", "evidence"],
        "properties": {
          "instrument_id": {"type": "string", "pattern": "^(TW|JP|US):(STOCK|ETF):[A-Z0-9.-]+$"},
          "listing_status": {"const": "active"},
          "verification_status": {"enum": ["verified", "verified_after_correction"]},
          "symbol": {"type": "string", "minLength": 1},
          "exchange": {"type": "string", "minLength": 2},
          "legal_name": {"type": "string", "minLength": 1},
          "asset_type": {"enum": ["stock", "etf"]},
          "trading_currency": {"enum": ["TWD", "JPY", "USD"]},
          "benchmark_id": {"type": "string", "minLength": 1},
          "selection_rationale": {"type": "string", "minLength": 1},
          "official_url": {"type": "string", "pattern": "^https://"},
          "tracking_index": {
            "type": "object", "additionalProperties": false,
            "required": ["verification_status", "name", "source_id", "official_url", "note"],
            "properties": {
              "verification_status": {"const": "verified"},
              "name": {"type": "string", "minLength": 1},
              "source_id": {"type": "string", "minLength": 1},
              "official_url": {"type": "string", "pattern": "^https://"},
              "note": {"type": "string", "minLength": 1}
            }
          },
          "history": {
            "type": "object", "additionalProperties": false,
            "required": ["live_age_status", "start_date", "basis", "note", "usable_history_status", "usable_history_note"],
            "properties": {
              "live_age_status": {"enum": ["sufficient", "limited"]},
              "start_date": {"type": ["string", "null"], "format": "date"},
              "basis": {"type": "string", "minLength": 1},
              "note": {"type": "string", "minLength": 1},
              "usable_history_status": {"enum": ["ready", "conditional", "blocked", "pending"]},
              "usable_history_note": {"type": "string", "minLength": 1}
            }
          },
          "liquidity": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "note"],
            "properties": {
              "status": {"const": "quantitative_review_pending"},
              "note": {"type": "string", "minLength": 1}
            }
          },
          "theme_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "replacement_assessment": {"enum": ["retain_for_owner_review", "replacement_candidate"]},
          "review_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "models": {
            "type": "object", "additionalProperties": false,
            "required": ["h_model", "reverse_dcf", "etf_look_through", "cobweb_supply_demand"],
            "properties": {
              "h_model": {"$ref": "#/$defs/model_review"},
              "reverse_dcf": {"$ref": "#/$defs/model_review"},
              "etf_look_through": {"$ref": "#/$defs/model_review"},
              "cobweb_supply_demand": {"$ref": "#/$defs/model_review"}
            }
          },
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
        }
      }
    },
    "overlap_groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["overlap_id", "country", "severity", "members", "basis", "owner_question", "evidence"],
        "properties": {
          "overlap_id": {"type": "string", "minLength": 1},
          "country": {"enum": ["TW", "JP", "US"]},
          "severity": {"enum": ["medium", "high"]},
          "members": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "basis": {"type": "string", "minLength": 1},
          "owner_question": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
        }
      }
    },
    "issuer_concentration": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["country", "issuer", "fund_count", "share_of_market_etfs", "assessment", "evidence"],
        "properties": {
          "country": {"enum": ["TW", "JP", "US"]},
          "issuer": {"type": "string", "minLength": 1},
          "fund_count": {"type": "integer", "minimum": 1, "maximum": 5},
          "share_of_market_etfs": {"type": "string", "minLength": 1},
          "assessment": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
        }
      }
    },
    "owner_decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decision_id", "question", "affected_instrument_ids", "evidence_gap"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "affected_instrument_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_gap": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "model_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["conditional", "not_applicable"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidence_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "url", "observed_at", "claims", "publication_use"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "observed_at": {"type": "string", "format": "date"},
        "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["identity", "listing", "currency", "asset_type", "live_age", "liquidity", "themes", "selection_rationale", "tracking_index", "overlap", "issuer_concentration"]}},
        "publication_use": {"enum": ["metadata_link_only", "open_data_fact"]}
      }
    }
  }
}
