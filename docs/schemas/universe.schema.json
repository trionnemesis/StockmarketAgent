{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/StockmarketAgent/schemas/universe.schema.json",
  "title": "StockmarketAgent universe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "universe_version", "updated_at", "review_status", "instruments"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "universe_version": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "review_status": {"enum": ["owner_approval_required", "approved"]},
    "instruments": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument_id", "country", "market", "symbol", "slug", "name_zh", "name_en", "asset_type", "currency", "benchmark_id", "themes", "status", "enabled", "selection_rationale", "source_policy_id"],
        "properties": {
          "instrument_id": {"type": "string", "pattern": "^(TW|JP|US):(STOCK|ETF):[A-Z0-9.-]+$"},
          "country": {"enum": ["TW", "JP", "US"]},
          "market": {"type": "string", "minLength": 2},
          "symbol": {"type": "string", "minLength": 1},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name_zh": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "asset_type": {"enum": ["stock", "etf"]},
          "currency": {"enum": ["TWD", "JPY", "USD"]},
          "benchmark_id": {"type": "string", "minLength": 1},
          "themes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["proposed", "approved", "retired"]},
          "enabled": {"type": "boolean"},
          "selection_rationale": {"type": "string", "minLength": 1},
          "source_policy_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
