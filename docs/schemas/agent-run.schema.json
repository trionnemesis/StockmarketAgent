{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/StockmarketAgent/schemas/agent-run.schema.json",
  "title": "StockmarketAgent agent run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "run_type", "as_of_date", "started_at", "completed_at", "git_sha", "input_hash", "source_manifest_hash", "schema_versions", "model_version", "status", "outputs", "warnings", "errors", "manual_review_required"],
  "properties": {
    "run_id": {"type": "string", "minLength": 8},
    "run_type": {"const": "fixture_build"},
    "as_of_date": {"type": "string", "format": "date"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "git_sha": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "model_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "failed"]},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "manual_review_required": {"const": true}
  }
}
