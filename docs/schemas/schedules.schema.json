{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/StockmarketAgent/schemas/schedules.schema.json",
  "title": "StockmarketAgent proposed research schedules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timezone", "automation_enabled", "schedules"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "timezone": {"const": "Asia/Taipei"},
    "automation_enabled": {"const": false},
    "schedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cron", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "cron": {"type": "string", "minLength": 9},
          "status": {"const": "proposal_only"}
        }
      }
    }
  }
}
