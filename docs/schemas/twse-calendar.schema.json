{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/StockmarketAgent/schemas/twse-calendar.schema.json",
  "title": "TWSE Calendar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calendar_id", "market", "timezone", "source", "coverage", "weekend_days", "closed_dates", "freshness_policy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "calendar_id": {"type": "string", "minLength": 1},
    "market": {"const": "TWSE"},
    "timezone": {"const": "Asia/Taipei"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "url", "query_year_roc", "retrieved_at"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "query_year_roc": {"type": "integer", "minimum": 1},
        "retrieved_at": {"type": "string", "format": "date"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "weekend_days": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 6}
    },
    "closed_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "reason"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_kind", "same_day_expected_after", "description"],
      "properties": {
        "policy_kind": {"const": "project_defined"},
        "same_day_expected_after": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
