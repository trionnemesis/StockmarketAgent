{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/StockmarketAgent/schemas/observation-archive-entry.schema.json",
  "title": "Taiwan Observation Archive Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "archive_id", "archive_path", "instrument_id", "symbol", "slug", "asset_type", "source_kind", "official_as_of", "market_session_date", "fetched_at", "content_sha256", "revision", "observation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "archive_id": {"type": "string", "minLength": 1},
    "archive_path": {"type": "string", "pattern": "^archive/[0-9]{4,6}/[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[a-f0-9]{16}\\.json$"},
    "instrument_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "pattern": "^[0-9]{4,6}$"},
    "slug": {"type": "string", "minLength": 1},
    "asset_type": {"enum": ["stock", "etf"]},
    "source_kind": {"const": "official_observation"},
    "official_as_of": {"type": "string", "format": "date"},
    "market_session_date": {"type": "string", "format": "date"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "relation", "previous_archive_id", "correction_of_archive_id"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "relation": {"enum": ["initial", "new_session", "correction"]},
        "previous_archive_id": {"type": ["string", "null"]},
        "correction_of_archive_id": {"type": ["string", "null"]}
      }
    },
    "observation": {"$ref": "observed-facts.schema.json"}
  }
}
